uint16 PROTOCOL_MAJOR=1
uint16 PROTOCOL_MINOR=0

uint8 MODE_DISABLED=0
uint8 MODE_FJT_READY=1
uint8 MODE_ROLLING_READY=2
uint8 MODE_RESTART_REQUIRED=3

uint16 protocol_major
uint16 protocol_minor
unique_identifier_msgs/UUID request_id
uint8 expected_mode
uint8 target_mode
---
uint8 ERROR_NONE=0
uint8 ERROR_WRONG_PROTOCOL=1
uint8 ERROR_WRONG_REQUEST=2
uint8 ERROR_WRONG_MODE=3
uint8 ERROR_NOT_ENABLED=4
uint8 ERROR_SESSION_BUSY=5
uint8 ERROR_SESSION_EXISTS=6
uint8 ERROR_WRONG_BOOT=7
uint8 ERROR_WRONG_SESSION=8
uint8 ERROR_WRONG_CLIENT=9
uint8 ERROR_AXIS_SET_MISMATCH=10
uint8 ERROR_SOURCE_MOVING=11
uint8 ERROR_TAKEOVER_MISMATCH=12
uint8 ERROR_UNSAFE_HOLD=13
uint8 ERROR_FEEDBACK_STALE=14
uint8 ERROR_LIMITS_UNAVAILABLE=15
uint8 ERROR_SWITCH_REJECTED=16
uint8 ERROR_SWITCH_TIMEOUT=17
uint8 ERROR_RESTART_REQUIRED=18
uint8 ERROR_NOT_READY=19

bool success
unique_identifier_msgs/UUID request_id
uint8 error_code
uint8 resulting_mode
bool source_controller_deactivated
bool target_controller_activated
bool restart_required
